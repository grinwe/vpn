# Provisioning worker image.
#
# Unlike the API image, this one carries ansible, the SSH client and the
# playbooks themselves. It MUST be the only container in the deployment with
# access to the VPN nodes' SSH private key — mount it read-only at runtime,
# don't bake it into the image.
FROM python:3.11-slim

# ansible needs openssh-client to talk to the nodes; rsync is handy for a
# number of roles; gcc/libffi are kept out because ansible-core wheels ship
# pure-python.
#
# iputils-ping + traceroute: the staged local probe in
# app/services/diagnostics.py shells out to `ping`/`traceroute` from THIS
# container (worker-side, before any SSH hop). Without them the probe
# degrades to status=skip ("ping не установлен в контейнере") instead of
# giving a real ICMP/path signal.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-client \
        sshpass \
        rsync \
        ca-certificates \
        iputils-ping \
        traceroute \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Build context is the repository root (see docker-compose `worker.build`),
# so all COPY paths are relative to it.
COPY backend/requirements.txt backend/requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-worker.txt

COPY backend/app ./app
COPY backend/alembic.ini ./alembic.ini
COPY infra /app/infra

# Install Galaxy collections the roles depend on (ansible.posix for
# authorized_key/sysctl, community.general for misc modules). ansible-core
# ships with nothing bundled, so without this every bootstrap playbook fails
# with "couldn't resolve module/action 'authorized_key'".
RUN ansible-galaxy collection install -r /app/infra/ansible/requirements.yml

# The backend expects ANSIBLE_ROOT to resolve to `<backend>/../infra/ansible`
# relative to the package location. We set it explicitly here so the worker
# finds the playbooks regardless of the container layout.
ENV ANSIBLE_ROOT=/app/infra/ansible \
    ANSIBLE_HOST_KEY_CHECKING=False \
    PYTHONUNBUFFERED=1

# SSH config dir for the provisioning user. Mount the private key at
# /root/.ssh/id_ed25519 (or configure via ANSIBLE_PRIVATE_KEY_FILE).
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

# IMPORTANT: launch via `-c "from app.worker import main; main()"`, NOT
# `python -m app.worker`. The latter loads the module as `__main__`, and RQ
# later does `importlib.import_module("app.worker")` to execute jobs — which
# re-runs worker.py top-level code (including the prometheus Counter() calls)
# under a *different* module name, crashing every job with
# "Duplicated timeseries in CollectorRegistry". See the comment in worker.py.
CMD ["python", "-c", "from app.worker import main; main()"]
