[Interface]
PrivateKey = {{ item.private_key }}
Address = {{ item.address_v4 }}
# Table = off prevents WireGuard from auto-managing routes.
# Per-interface metric-200 default route added in PostUp so Xray can
# bind each outbound to its own wgN via sockopt.interface, while SSH
# and Ansible continue to exit on the main interface (metric 0/100).
Table = off

PostUp  = ip route add 0.0.0.0/0 dev %i metric 200 || true
PostDown = ip route del 0.0.0.0/0 dev %i metric 200 || true

[Peer]
PublicKey = {{ item.exit_public_key }}
Endpoint = {{ item.endpoint }}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
