[Interface]
PrivateKey = {{ relay_wg_private_key }}
Address = {{ relay_wg_address_v4 }}
# Table = off prevents WireGuard from auto-managing routes.
# We add manual metric-200 routes via PostUp so that:
#   - Xray traffic (bound to wg0 via sockopt) goes through the tunnel
#   - Management traffic (SSH, Ansible) stays on the main interface
#     (which has the default route at metric 0/100)
Table = off

PostUp  = ip route add 0.0.0.0/0 dev %i metric 200 || true
PostDown = ip route del 0.0.0.0/0 dev %i metric 200 || true

[Peer]
PublicKey = {{ relay_wg_exit_public_key }}
Endpoint = {{ relay_wg_endpoint }}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
