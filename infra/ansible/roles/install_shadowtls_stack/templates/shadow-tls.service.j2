[Unit]
Description=Shadow-TLS v3 Server
Documentation=https://github.com/ihciah/shadow-tls
After=network.target ssserver.service
Requires=ssserver.service

[Service]
Type=simple
# shadow-tls v3: wraps TLS 1.3 traffic impersonating www.cloudflare.com,
# forwards decrypted data to the loopback ss-rust instance. The
# ``--v3`` flag enables version-3 wire format (resistant to active
# probing that broke v1/v2). ``--strict`` rejects non-TLS-1.3 clients
# so we don't regress onto weaker obfuscation.
ExecStart={{ shadowtls_binary_dest }} \
    --v3 --strict \
    server \
    --listen 0.0.0.0:{{ shadowtls_port | int }} \
    --server 127.0.0.1:{{ shadowtls_ss_loopback_port | int }} \
    --tls {{ shadowtls_handshake_domain }}:443 \
    --password {{ shadowtls_password }}
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
# shadow-tls binds to :443 by default, which needs CAP_NET_BIND_SERVICE
# when running as non-root. We run as root for simplicity (matches xray
# role); revisit if we ever introduce a dedicated user.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
