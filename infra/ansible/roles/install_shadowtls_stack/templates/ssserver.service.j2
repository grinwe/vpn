[Unit]
Description=Shadowsocks-rust Server (behind shadow-tls)
Documentation=https://github.com/shadowsocks/shadowsocks-rust
After=network.target

[Service]
Type=simple
ExecStart={{ ssrust_binary_dest }} -c {{ shadowtls_ss_config }}
Restart=on-failure
RestartSec=3
# Hardening — ss-rust never needs to write to disk after startup, and
# binds only to 127.0.0.1, so we lock down the unit.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths={{ shadowtls_config_dir }}
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
