# {{ ansible_managed }}
#
# Stage-4 anti-probing front для VLESS-XHTTP ноды.
#
#   Clients → :443 (nginx, TLS termination) ──┬─→ {{ vless_xhttp_path }}/*       → xray @ 127.0.0.1:{{ vless_xhttp_internal_port }} (xhttp)
#                                              └─→ everything else               → camo landing (200)
#
# До Stage-4 xray сам висел на :443 с TLS. Активные пробры получали
# голый 404 от Go-stack + фингерпринт в Server-заголовке = явный VPN-
# маркер. Теперь TLS терминирует nginx, xray сидит на loopback,
# неизвестные пути уходят на "internal tools portal".
#
# Certbot renewal: cert обновляется через /etc/letsencrypt/renewal-hooks/
# deploy/xhttp-reload.sh — перезагружает nginx и рестартит xray-xhttp,
# чтобы оба подхватили свежий fullchain.pem без ручной возни.

server {
    listen 80;
    listen [::]:80;
    server_name {{ vless_xhttp_domain }};

    # Webroot для ACME — certbot renewal пользуется тем же каталогом,
    # что и первичный issuance. Без этого location автоматический
    # renew ломается после того, как мы переключились с standalone.
    location /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ vless_xhttp_domain }};

    ssl_certificate     {{ _xhttp_cert_path }};
    ssl_certificate_key {{ _xhttp_key_path }};

    # Mozilla intermediate 2024 profile — TLS 1.2+1.3 + ECDHE/CHACHA.
    # Тот же набор, что и на web-фронте (deploy_web_frontend),
    # чтобы JA3/JA4 двух наших доменов не расходились и не давали
    # сравнительного фингерпринта по циферкам.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Убираем версию nginx из Server-header — активный пробер не должен
    # отличить наш xhttp-фронт от web-фронта по build-строке.
    server_tokens off;
    more_clear_headers 'X-Powered-By';

    add_header Strict-Transport-Security "max-age=31536000" always;

    # XHTTP традиционно гоняет большие POST/long-poll'ы, но клиенту
    # незачем слать > пары мегабайт за раз — cap на всякий случай.
    client_max_body_size 4m;

    # XHTTP location — проксируем на loopback-xray.
    # ВНИМАНИЕ: xhttp mode=auto комбинирует GET long-poll + POST stream-up.
    # В HTTP/1.1 режиме оно работает, но если клиент явно выбирает
    # "stream-up" — может потребоваться HTTP/2 end-to-end. Если canary
    # на ru-dc-01 покажет, что handshake ломается, первый шаг отката —
    # переключить vless_xhttp_mode на "packet-up" (чистый long-poll).
    location {{ vless_xhttp_path }} {
        proxy_pass http://127.0.0.1:{{ vless_xhttp_internal_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # xhttp stream-up поднимает длительные соединения — буферизация
        # бэкенда убила бы low-latency flow.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Скрываем upstream-заголовки, чтобы xray-specific маркеры не
        # протекали наружу (на всякий случай — xray обычно не шлёт
        # Server, но защищаемся от будущих правок).
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
    }

    # Всё остальное — camo landing. 404-по-дефолту = VPN-маркер.
    location / {
        root {{ vless_xhttp_camo_root }};
        index index.html;
        try_files $uri $uri/ /index.html =404;
    }
}

# map нужен для корректной работы proxy_set_header Connection
# в xhttp-location'е выше. Должен быть в http{} scope — Debian-nginx
# подтягивает этот файл через include /etc/nginx/sites-enabled/*,
# поэтому map на верхнем уровне файла работает (context: http).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
