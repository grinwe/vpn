[Unit]
Description=Refresh xray geoip.dat (v2fly community data)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/bin/xray

[Service]
Type=oneshot
# Atomic replace: если curl упадёт посреди скачивания, старый geoip.dat цел,
# xray продолжает жить на предыдущей копии. mv и последующий restart xray
# срабатывают только после успешной выкачки.
ExecStart=/usr/bin/curl --fail --silent --show-error --location \
  --max-time 120 \
  --output /usr/local/share/xray/geoip.dat.new \
  https://github.com/v2fly/geoip/releases/latest/download/geoip.dat
ExecStart=/bin/mv /usr/local/share/xray/geoip.dat.new /usr/local/share/xray/geoip.dat
# Оба рестарта — try-restart с best-effort префиксом `-`. try-restart
# трогает только АКТИВНЫЕ юниты: на чисто-XHTTP ноде xray.service отключён
# install_vless_reality — не воскрешаем его со stale config.json; на
# чисто-Reality ноде нет xray-xhttp. `-` гасит non-zero от inactive/
# not-loaded юнита, иначе падение одного флавора пометило бы oneshot
# failed И оборвало бы следующую строку ExecStart — живой xray так и не
# получил бы свежий geoip.
ExecStart=-/bin/systemctl try-restart xray
ExecStart=-/bin/systemctl try-restart xray-xhttp
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
