{% set _fan_out = xray_relay_outbounds | default([]) %}
{% set _primary = xray_primary_interface | default('') %}
{
  "log": {
    "loglevel": "info",
    "access": "/var/log/xray/access-xhttp.log"
  },
  "api": {
    "tag": "api",
    "services": ["StatsService"]
  },
  "stats": {},
  "dns": {
    "servers": [
      "77.88.8.8",
      "8.8.8.8",
      "1.1.1.1"
    ],
    "queryStrategy": "UseIP"
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api-in"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "domain": [
          "regexp:\\.ru$",
          "regexp:\\.su$",
          "regexp:\\.xn--p1ai$",
          "regexp:^(yandex|mail|vk|ok|rutube|sberbank|gosuslugi|tinkoff|wildberries|ozon|avito|rambler|2gis|kinopoisk|dzen|hh|lenta|ria|tass|rbc|habr|dtf)\\..+$"
        ],
        "outboundTag": "direct-local"
      },
      {
        "type": "field",
        "ip": ["geoip:ru", "geoip:private"],
        "outboundTag": "direct-local"
      }{% for _rule in _fan_out if _rule.emails %},
      {
        "type": "field",
        "user": {{ _rule.emails | to_json }},
        "outboundTag": "direct-{{ _rule.interface }}"
      }{% endfor %}
    ]
  },
  "inbounds": [
    {
      "tag": "api-in",
      "listen": "127.0.0.1",
      "port": {{ vless_xhttp_api_port | default(10087) }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    },
    {
      "tag": "vless-xhttp",
      "listen": "127.0.0.1",
      "port": {{ vless_xhttp_internal_port | int }},
      "protocol": "vless",
      "settings": {
        "clients": {{ vless_xhttp_existing_clients | default([]) | to_json }},
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          {#- host дублирует домен в САМ xray-конфиг — чтобы он пережил DR.
              При потере БД восстановление читает xray-конфиги с нод
              (aggregate_xray_inventory.py берёт xhttpSettings.host как sni);
              иначе домен живёт ТОЛЬКО в nginx-vhost и терялся в restore.sql
              (sni=NULL → билдер сабки падал на IP ноды). Рантайм-консистентно:
              nginx форвардит Host=домен (proxy_set_header Host $host,
              server_name=домен), клиент тоже шлёт host=домен. -#}
          "host": "{{ vless_xhttp_domain }}",
          "path": "{{ vless_xhttp_path | default('/xh') }}",
          "mode": "{{ vless_xhttp_mode | default('auto') }}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"{% if _primary %},
      "streamSettings": {
        "sockopt": {
          "interface": "{{ _primary }}",
          "tcpKeepAliveInterval": 30
        }
      }{% endif %}
    },
    {
      "protocol": "freedom",
      "tag": "direct-local"
    }{% for _ob in _fan_out %},
    {
      "protocol": "freedom",
      "tag": "direct-{{ _ob.interface }}",
      "streamSettings": {
        "sockopt": {
          "interface": "{{ _ob.interface }}",
          "tcpKeepAliveInterval": 30
        }
      }
    }{% endfor %},
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
