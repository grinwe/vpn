{% set _fan_out = xray_relay_outbounds | default([]) %}
{% set _primary = xray_primary_interface | default('') %}
{
  "log": {
    "loglevel": "info",
    "access": "/var/log/xray/access-reality.log"
  },
  "api": {
    "tag": "api",
    "services": ["StatsService"]
  },
  "stats": {},
  "dns": {
    "servers": [
      "77.88.8.8",
      "8.8.8.8",
      "1.1.1.1"
    ],
    "queryStrategy": "UseIP"
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api-in"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "domain": [
          "regexp:\\.ru$",
          "regexp:\\.su$",
          "regexp:\\.xn--p1ai$",
          "regexp:^(yandex|mail|vk|ok|rutube|sberbank|gosuslugi|tinkoff|wildberries|ozon|avito|rambler|2gis|kinopoisk|dzen|hh|lenta|ria|tass|rbc|habr|dtf)\\..+$"
        ],
        "outboundTag": "direct-local"
      },
      {
        "type": "field",
        "ip": ["geoip:ru", "geoip:private"],
        "outboundTag": "direct-local"
      }{% for _rule in _fan_out if _rule.emails %},
      {
        "type": "field",
        "user": {{ _rule.emails | to_json }},
        "outboundTag": "direct-{{ _rule.interface }}"
      }{% endfor %}
    ]
  },
  "inbounds": [
    {
      "tag": "api-in",
      "listen": "127.0.0.1",
      "port": {{ vless_reality_api_port | default(10085) }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    },
    {
      "tag": "vless-reality",
      "listen": "{{ '127.0.0.1' if reality_stream_unify | default(false) else '0.0.0.0' }}",
      "port": {{ vless_reality_port | int }},
      "protocol": "vless",
      "settings": {
        "clients": {{ vless_reality_existing_clients | default([]) | to_json }},
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ vless_reality_dest }}",
          "xver": 0,
          "serverNames": [
            "{{ vless_reality_sni }}",
            "{{ vless_reality_sni | regex_replace('^www\\.', '') }}"
          ],
          "privateKey": "{{ vless_reality_private_key }}",
          "shortIds": [
            "{{ vless_reality_short_id }}",
            ""
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"{% if _primary %},
      "streamSettings": {
        "sockopt": {
          "interface": "{{ _primary }}",
          "tcpKeepAliveInterval": 30
        }
      }{% endif %}
    },
    {
      "protocol": "freedom",
      "tag": "direct-local"
    }{% for _ob in _fan_out %},
    {
      "protocol": "freedom",
      "tag": "direct-{{ _ob.interface }}",
      "streamSettings": {
        "sockopt": {
          "interface": "{{ _ob.interface }}",
          "tcpKeepAliveInterval": 30
        }
      }
    }{% endfor %},
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
