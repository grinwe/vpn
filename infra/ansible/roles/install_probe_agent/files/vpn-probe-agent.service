[Unit]
Description=VPN Probe Agent — node-to-node health checks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vpn-probe-agent/agent.py
EnvironmentFile=/etc/vpn-probe-agent/probe.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
