listen: :{{ hysteria2_port | int }}

{% if hysteria2_cert_path | default('') | length > 0 %}
tls:
  cert: {{ hysteria2_cert_path }}
  key: {{ hysteria2_key_path }}
{% else %}
# ACME auto-cert
acme:
  domains:
    - {{ hysteria2_domain }}
  email: admin@{{ hysteria2_domain }}
{% endif %}

{% if hysteria2_obfs | default('') | length > 0 %}
obfs:
  type: {{ hysteria2_obfs }}
  salamander:
    password: {{ hysteria2_obfs_password }}
{% endif %}

bandwidth:
  up: {{ hysteria2_up_mbps | default(100) }} mbps
  down: {{ hysteria2_down_mbps | default(100) }} mbps

# Auth via password file — managed by manage_hy2_user.sh
auth:
  type: userpass
  userpass:
{% for _u, _p in (hysteria2_existing_userpass | default({}) | dictsort) %}
    {{ _u }}: "{{ _p }}"
{% endfor %}
{% if '__sentinel__' not in (hysteria2_existing_userpass | default({})) %}
    # Sentinel-заглушка: hysteria2 FATAL'ит (exit 1 → краш-луп) на пустом
    # userpass. Нода с включённым hy2, но без назначенных юзеров (свежий
    # hy2-конфиг до того как diverse-sub раздаст девайсы) иначе уходит в вечный
    # краш-луп. Держим один заглушечный юзер со случайным 32-символьным
    # паролем: клиенту НЕ выдаётся, угадать нельзя (=реальный секрет), реальных
    # юзеров manage_hy2_user.sh дописывает рядом (setdefault по userpass;
    # заглушку del не трогает).
    #
    # Генерится ТОЛЬКО при первом рендере: существующие записи (включая сам
    # sentinel) приезжают из slurp'а выше — иначе роль стирала всех юзеров
    # ноды на каждом прогоне, а новый случайный sentinel делал файл вечно
    # changed и дёргал рестарт hysteria-server (аудит 2026-07-25).
    __sentinel__: "{{ lookup('password', '/dev/null chars=ascii_letters,digits length=32') }}"
{% endif %}
