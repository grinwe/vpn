{% set _bind = hysteria2_bind_device | default(xray_primary_interface | default('')) %}
listen: :{{ hysteria2_port | int }}

{% if hysteria2_cert_path | default('') | length > 0 %}
tls:
  cert: {{ hysteria2_cert_path }}
  key: {{ hysteria2_key_path }}
{% else %}
# ACME auto-cert
acme:
  domains:
    - {{ hysteria2_domain }}
  email: admin@{{ hysteria2_domain }}
{% endif %}

{% if hysteria2_obfs | default('') | length > 0 %}
obfs:
  type: {{ hysteria2_obfs }}
  salamander:
    password: {{ hysteria2_obfs_password }}
{% endif %}

bandwidth:
  up: {{ hysteria2_up_mbps | default(100) }} mbps
  down: {{ hysteria2_down_mbps | default(100) }} mbps

{% if _bind %}
# ── Split-tunnel (relay-нода) ─────────────────────────────────────────────
# До 2026-07-28 этой секции не было вовсе, и hy2 на relay-ноде выпускал ВЕСЬ
# трафик с российского IP: клиент показывал «подключено», РУ-сайты работали, а
# заблокированное оставалось заблокированным. Причина не в отсутствии acl, а в
# маршрутизации: WG-дефолт на relay'е намеренно хуже основного
# (relay_jump_node: `Table = off` + PostUp с `metric 200`), поэтому в туннель
# попадает только то, что процесс ЯВНО забиндил на интерфейс. xray это делает
# через sockopt.interface, а hysteria — отдельный демон, и до этой секции не
# биндил ничего.
#
# `tunnel` стоит ПЕРВЫМ намеренно: при отсутствии ACL hysteria шлёт всё в
# первый outbound (док: «If you do not use ACL, all connections will always be
# routed through the first ('default') outbound»). Если ACL когда-нибудь не
# применится, деградация будет в сторону «РУ-сайты видят зарубежный IP», а не
# «VPN не работает вовсе».
outbounds:
  - name: tunnel
    type: direct
    direct:
      bindDevice: {{ _bind }}
  - name: local
    type: direct
    # БЕЗ bindDevice — это и есть «мимо туннеля, с IP самой ноды», цель
    # РУ-правил ниже. mode указан явно, чтобы поведение не зависело от того,
    # как hysteria трактует пустую секцию.
    direct:
      mode: auto

# Правила матчатся сверху вниз, первое совпадение выигрывает. Списки зон и
# доменов — из роли ru_direct_list, той же, что кормит три xray-шаблона;
# `suffix:` в hysteria = домен + все поддомены (аналог `domain:` в xray).
acl:
  inline:
    # Приватные сети и loopback самой ноды клиенту недоступны — симметрично
    # правилу geoip:private → block в xray-конфигах.
    - reject(geoip:private)
{% for _z in ru_direct_zones %}
    - local(suffix:{{ _z }})
{% endfor %}
{% for _d in ru_direct_domains %}
    - local(suffix:{{ _d }})
{% endfor %}
    # Резолвится в РУ-IP → тоже напрямую (домен мог не попасть в список выше).
    - local(geoip:ru)
    # Всё остальное — в туннель к зарубежному exit'у.
    - tunnel(all)
  # Переиспользуем файл, который качает и обновляет роль xray_geoip: формат
  # общий (v2ray geoip.dat), второй копии и второго таймера не нужно.
  geoip: /usr/local/share/xray/geoip.dat
{% endif %}

# Auth via password file — managed by manage_hy2_user.sh
auth:
  type: userpass
  userpass:
{% for _u, _p in (hysteria2_existing_userpass | default({}) | dictsort) %}
    {{ _u }}: "{{ _p }}"
{% endfor %}
{% if '__sentinel__' not in (hysteria2_existing_userpass | default({})) %}
    # Sentinel-заглушка: hysteria2 FATAL'ит (exit 1 → краш-луп) на пустом
    # userpass. Нода с включённым hy2, но без назначенных юзеров (свежий
    # hy2-конфиг до того как diverse-sub раздаст девайсы) иначе уходит в вечный
    # краш-луп. Держим один заглушечный юзер со случайным 32-символьным
    # паролем: клиенту НЕ выдаётся, угадать нельзя (=реальный секрет), реальных
    # юзеров manage_hy2_user.sh дописывает рядом (setdefault по userpass;
    # заглушку del не трогает).
    #
    # Генерится ТОЛЬКО при первом рендере: существующие записи (включая сам
    # sentinel) приезжают из slurp'а выше — иначе роль стирала всех юзеров
    # ноды на каждом прогоне, а новый случайный sentinel делал файл вечно
    # changed и дёргал рестарт hysteria-server (аудит 2026-07-25).
    __sentinel__: "{{ lookup('password', '/dev/null chars=ascii_letters,digits length=32') }}"
{% endif %}
