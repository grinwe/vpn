# {{ ansible_managed }}
#
# Rendered by roles/deploy_app_stack. Do not edit by hand on the host
# — changes will be overwritten on the next ansible-playbook run.
# Change values via group_vars/<group>/vault.yml instead.

APP_ENV={{ deploy_app_stack_app_env | default('production') }}

# Версия выката из файла VERSION в корне репозитория (см. backend/app/version.py).
# Едет в бэкенд/воркер/бота как APP_VERSION, во фронты — build-arg'ом
# VITE_APP_VERSION, на ноды — extra_vars vpn_release_version при бутстрапе.
# Смена значения меняет .env и дерево → ребилд образов, поэтому фронты
# подхватывают новую версию тем же выкатом.
APP_VERSION={{ deploy_app_stack_release_version | default('0.0.0-dev') }}

# Admin SPA base path — подставляется в docker-compose как
# VITE_ADMIN_BASE_PATH (build-arg) и ADMIN_BASE_PATH (runtime env
# для nginx envsubst). Менять через vault_admin_secret_path в
# group_vars/web/vault.yml; смена требует ребилда admin-контейнера.
ADMIN_BASE_PATH={{ deploy_app_stack_admin_base_path | default('admin') }}

POSTGRES_PASSWORD={{ deploy_app_stack_postgres_password }}
DATABASE_URL=postgresql+psycopg2://vpn:{{ deploy_app_stack_postgres_password }}@db:5432/vpn

ADMIN_API_TOKEN={{ deploy_app_stack_admin_api_token }}
APP_SECRET_KEY={{ deploy_app_stack_app_secret_key }}

# Structured logging: "json" for prod log aggregators, "console" for dev.
LOG_FORMAT={{ deploy_app_stack_log_format | default('json') }}
LOG_LEVEL={{ deploy_app_stack_log_level | default('INFO') }}

BOT_TOKEN={{ deploy_app_stack_bot_token }}
# Public @username of the bot (without the @), used by the backend to
# build the referral share link (https://t.me/<username>?start=ref_...).
BOT_USERNAME={{ deploy_app_stack_bot_username }}
# Публичные документы сервиса для кнопок «О сервисе» в боте (оферта,
# возвраты, ПД) — страницы кладёт роль deploy_web_frontend в camo-root/legal/.
LEGAL_BASE_URL={{ deploy_app_stack_legal_base_url | default("https://" ~ deploy_web_frontend_domain ~ "/legal") }}
ADMIN_IDS={{ deploy_app_stack_admin_ids }}

PAYMENT_PROVIDER={{ deploy_app_stack_payment_provider }}
# Stage 9a — comma-separated rotation pool. When set, the backend
# picks one provider per checkout. Leave empty to keep single-provider
# behaviour from PAYMENT_PROVIDER above.
PAYMENT_PROVIDERS={{ deploy_app_stack_payment_providers | default('') }}
# Stage 9b — меню выбора способа оплаты в боте (comma-separated имена
# провайдеров, например "telegram_stars,lava_top,tribute"). Пусто или
# одно имя — меню не показывается (старое поведение).
PAYMENT_PROVIDER_CHOICES={{ deploy_app_stack_payment_provider_choices | default('') }}
TELEGRAM_STARS_WEBHOOK_SECRET={{ deploy_app_stack_telegram_stars_webhook_secret }}

# Stage 9b — карты РФ/СБП: lava.top + Tribute (docs/PLAN_LAVA_TOP.md).
# LAVA_TOP_OFFER_ID — offerId продукта с «Ценой по запросу через API»;
# LAVA_TOP_WEBHOOK_SECRET — наш секрет, продублированный в кабинете
# lava.top (тип вебхук-авторизации «API key»); LAVA_TOP_EMAIL_DOMAIN —
# домен синтетических email покупателей (inv<invoice_id>@домен).
# Tribute: подпись вебхука — HMAC от API-ключа, отдельного секрета нет;
# пустые title/description = нейтральные дефолты драйвера.
LAVA_TOP_API_KEY={{ deploy_app_stack_lava_top_api_key | default('') }}
LAVA_TOP_OFFER_ID={{ deploy_app_stack_lava_top_offer_id | default('') }}
LAVA_TOP_WEBHOOK_SECRET={{ deploy_app_stack_lava_top_webhook_secret | default('') }}
LAVA_TOP_EMAIL_DOMAIN={{ deploy_app_stack_lava_top_email_domain | default('') }}
{# Пусто → драйвер использует прод-URL по умолчанию; override для стейджа. #}
LAVA_TOP_API_BASE={{ deploy_app_stack_lava_top_api_base | default('') }}
# Одна интеграция lava — два имени провайдера: lava_top = карта РФ
# (эквайрер SMART_GLOCAL, paymentMethod CARD), lava_top_sbp = СБП (агрегатор
# PAY2ME, paymentMethod SBP). Единая кнопка «карта / СБП» через PAY2ME без
# метода сломалась 2026-09-19 (lava закрыл карту у PAY2ME → 400 «Restricted
# payment method type»).
LAVA_TOP_CARD_PROVIDER={{ deploy_app_stack_lava_top_card_provider | default('SMART_GLOCAL') }}
LAVA_TOP_SBP_PROVIDER={{ deploy_app_stack_lava_top_sbp_provider | default('PAY2ME') }}
{# Авто-сверка карточных платежей lava (вебхук-независимо): воркер раз в N
   секунд опрашивает /api/v2/invoices и зачисляет pending-счета с COMPLETED-
   продажей. 0 = выключить. #}
LAVA_TOP_RECONCILE_INTERVAL={{ deploy_app_stack_lava_top_reconcile_interval | default(60) }}
TRIBUTE_API_KEY={{ deploy_app_stack_tribute_api_key | default('') }}
TRIBUTE_ORDER_TITLE={{ deploy_app_stack_tribute_order_title | default('') }}
TRIBUTE_ORDER_DESCRIPTION={{ deploy_app_stack_tribute_order_description | default('') }}
TRIBUTE_API_BASE={{ deploy_app_stack_tribute_api_base | default('') }}

# #62 — Telegram native webhook mode. When all three vars are set, the
# backend registers itself as the Bot API webhook receiver on startup,
# processes Stars payments directly, and forwards other updates to the
# bot over the Docker network. Eliminates the shared-secret forwarding.
TELEGRAM_WEBHOOK_SECRET_TOKEN={{ deploy_app_stack_telegram_webhook_secret_token | default('') }}
TELEGRAM_WEBHOOK_URL={{ deploy_app_stack_telegram_webhook_url | default('') }}
BOT_INTERNAL_WEBHOOK_URL={{ deploy_app_stack_bot_internal_webhook_url | default('http://bot:8081/webhook') }}
BOT_WEBHOOK_PORT={{ deploy_app_stack_bot_webhook_port | default(0) }}

# Telegram WebApp
WEBAPP_BASE_URL={{ deploy_app_stack_webapp_base_url }}
WEBAPP_JWT_SECRET={{ deploy_app_stack_webapp_jwt_secret }}
WEBAPP_JWT_TTL_SECONDS={{ deploy_app_stack_webapp_jwt_ttl_seconds }}
# #53 — Telegram initData handshake TTL. 300s default matches Telegram's
# recommended validation window; bounds the replay window if initData
# ever leaks. Do NOT confuse with WEBAPP_JWT_TTL_SECONDS (session JWT).
WEBAPP_INIT_DATA_TTL_SECONDS={{ deploy_app_stack_webapp_init_data_ttl_seconds | default(300) }}

# Path on the host to the SSH private key the worker uses for ansible
# against VPN nodes. Points at the file that tasks/main.yml installed
# (or /dev/null if no key was supplied — see compose's default).
PROVISIONING_SSH_KEY={{ deploy_app_stack_provisioning_key_dst if deploy_app_stack_provisioning_key_src | length > 0 else '/dev/null' }}

# Stage 4 — balance billing tunables. Override per-environment via
# group_vars if you want a different freeze cap, referral bonus or
# minimum topup; the defaults match the WebApp/bot copy ("заморозка
# 14 дней", "+50 ₽ другу", "минимум 100 ₽").
BALANCE_CHARGE_INTERVAL={{ deploy_app_stack_balance_charge_interval | default(3600) }}
FREEZE_DAYS={{ deploy_app_stack_freeze_days | default(7) }}
REFERRAL_BONUS_KOPECKS={{ deploy_app_stack_referral_bonus_kopecks | default(5000) }}
# Задержка доставки пуша «приведи друга» после первого скачивания конфига,
# часы (0 = сразу). Читает backend (очередь /api/notifications/pending).
REFERRAL_INVITE_DELAY_H={{ deploy_app_stack_referral_invite_delay_h | default(24) }}
# Триал: бесплатные дни (бонус сразу тратится на подписку на них), скрытый
# запас в часах сверх них (0 выключает) и окно пуша «бесплатные дни скоро
# закончатся». Дефолты совпадают с кодом (services/balance.py), group_vars
# их перебивают при необходимости.
TRIAL_DURATION_DAYS={{ deploy_app_stack_trial_duration_days | default(3) }}
TRIAL_HIDDEN_HOURS={{ deploy_app_stack_trial_hidden_hours | default(24) }}
TRIAL_EXPIRY_WARN_DAYS={{ deploy_app_stack_trial_expiry_warn_days | default(3) }}
MIN_TOPUP_KOPECKS={{ deploy_app_stack_min_topup_kopecks | default(10000) }}
EXTRA_DEVICE_KOPECKS_PER_MONTH={{ deploy_app_stack_extra_device_kopecks_per_month | default(10000) }}
# Stage 8 — boring-domain proxy URL for the dynamic sub link. Leave
# empty to keep relative-path behavior, or point at a Cloudflare
# Worker / separate domain so blocked-grinwer.online doesn't kill
# already-installed clients. Example: https://c1.cloudfn.app/sub
SUB_LINK_BASE_URL={{ deploy_app_stack_sub_link_base_url | default('') }}
# Запасной фронт саб-ссылки (мимо Cloudflare, прямо на origin) и доля
# токенов на нём, 0..100. Пусто/0 — вся раздача на основном домене.
SUB_LINK_BASE_URL_ALT={{ deploy_app_stack_sub_link_base_url_alt | default('') }}
SUB_LINK_ALT_SHARE={{ deploy_app_stack_sub_link_alt_share | default(0) }}
# Резервный базовый URL саб-ссылки (второй фронт на случай, если основной
# CDN/домен ляжет). Был только в docker-compose — задать его через ansible
# было нечем, а ручная правка .env стиралась следующим деплоем (аудит
# 2026-07-25). Пусто = фолбэка нет, поведение прежнее.
SUB_LINK_FALLBACK_BASE_URL={{ deploy_app_stack_sub_link_fallback_base_url | default('') }}
LOW_BALANCE_WARN_DAYS={{ deploy_app_stack_low_balance_warn_days | default(3) }}

# Self-heal tick for provisioning tasks stuck in ``pending`` because the
# RQ enqueue call hit a transient error at creation time. Scans every
# PENDING_RESCUE_INTERVAL seconds and re-enqueues any pending task
# older than PENDING_RESCUE_AGE seconds; dedupe on job_id means
# already-queued tasks are no-ops. Set INTERVAL=0 to disable.
PENDING_RESCUE_INTERVAL={{ deploy_app_stack_pending_rescue_interval | default(60) }}
PENDING_RESCUE_AGE={{ deploy_app_stack_pending_rescue_age | default(60) }}
# Эскалация rescue-тика: FORCE_AGE — пурж зомби-джоба и ре-энкью,
# ABANDON_AGE — пометить таску failed (древнюю опасно ре-ранить).
PENDING_RESCUE_FORCE_AGE={{ deploy_app_stack_pending_rescue_force_age | default(1800) }}
PENDING_RESCUE_ABANDON_AGE={{ deploy_app_stack_pending_rescue_abandon_age | default(86400) }}

# Cert-renewal тик (против fleet-wide cert-пожара 2026-07-22): внешняя проба
# TLS-expiry xhttp/ws-cdn + авто-renew LE за CERT_RENEWAL_DAYS до истечения,
# не больше MAX_PER_TICK нод за прогон. INTERVAL=0 — выключить.
CERT_RENEWAL_INTERVAL={{ deploy_app_stack_cert_renewal_interval | default(86400) }}
CERT_RENEWAL_DAYS={{ deploy_app_stack_cert_renewal_days | default(21) }}
CERT_RENEWAL_MAX_PER_TICK={{ deploy_app_stack_cert_renewal_max_per_tick | default(6) }}

# Reality-dest health: деградировавший dest = молча мёртвый Reality
# (инцидент 2026-07-23). AUTO_ROTATE по умолчанию ВЫКЛ: воркер пробит из NL,
# geo-чувствительные dest'ы (гос-сайты) дают false-positive.
REALITY_DEST_HEALTH_INTERVAL={{ deploy_app_stack_reality_dest_health_interval | default(86400) }}
REALITY_DEST_FAIL_THRESHOLD={{ deploy_app_stack_reality_dest_fail_threshold | default(2) }}
REALITY_DEST_AUTO_ROTATE={{ deploy_app_stack_reality_dest_auto_rotate | default(0) }}
REALITY_DEST_MAX_ROTATE_PER_TICK={{ deploy_app_stack_reality_dest_max_rotate_per_tick | default(3) }}

# Восстановление hy2-учёток после reinstall ноды (диск стёрт). Роль
# install_hysteria2 с 2026-07-25 сохраняет userpass сама, это второй пояс.
RESTORE_HY2_AFTER_REINSTALL={{ deploy_app_stack_restore_hy2_after_reinstall | default(1) }}

# Subprocess timeout (seconds) for `ansible-playbook` runs. Bump if
# nodes with slow package installs routinely hit the default 5-min cap.
ANSIBLE_PLAYBOOK_TIMEOUT={{ deploy_app_stack_ansible_playbook_timeout | default(300) }}

# ansible-core 2.19 compat: section [ssh_connection] из ansible.cfg
# больше не парсит pipelining/ssh_args/retries в нашем layout
# (см. POSTMORTEM_2026-05-19 + scripts/diag_ansible_perf.sh результаты:
# ANSIBLE_PIPELINING оставался default=False, ControlMaster не реюзался).
# Без этих env vars per-task время на ансибл выросло x3-5 после rebuild
# mgmt — каждая task делала свежий ssh + scp модуля. Env wins над cfg
# во всех версиях ansible, поэтому форсим именно env-уровень.
ANSIBLE_PIPELINING={{ deploy_app_stack_ansible_pipelining | default('True') }}
ANSIBLE_SSH_RETRIES={{ deploy_app_stack_ansible_ssh_retries | default(3) }}
ANSIBLE_SSH_ARGS={{ deploy_app_stack_ansible_ssh_args | default('-o ControlMaster=auto -o ControlPersist=10m -o ControlPath=~/.ansible/cp/%h-%p-%r -o ConnectTimeout=30 -o ConnectionAttempts=3 -o ServerAliveInterval=15 -o ServerAliveCountMax=3') }}

# Phase A — probe-agent (active TCP/TLS prober co-located with the
# backend on this host). Mint the token via:
#   curl -sS -X POST \
#     -H "X-Admin-Token: $ADMIN_API_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"probe-nl-web","scopes":["probe:read","probe:write"]}' \
#     http://127.0.0.1:8000/api/api-tokens
# Then store the returned plaintext as vault_probe_agent_token in
# group_vars/web/vault.yml and re-run the playbook. Empty token means
# the probe-agent container restart-loops on 401 — harmless but noisy.
PROBE_AGENT_TOKEN={{ deploy_app_stack_probe_agent_token | default('') }}
PROBE_AGENT_REGION={{ deploy_app_stack_probe_agent_region | default('eu-nl') }}
PROBE_AGENT_INTERVAL={{ deploy_app_stack_probe_agent_interval | default(60) }}
PROBE_AGENT_TIMEOUT={{ deploy_app_stack_probe_agent_timeout | default(5) }}
PROBE_AGENT_CONCURRENCY={{ deploy_app_stack_probe_agent_concurrency | default(16) }}

# Phase B — passive xray traffic stats collector. Worker SSHs into
# each active node every TRAFFIC_STATS_INTERVAL seconds and writes
# uplink/downlink/active_users into node_traffic_samples. 0 disables.
TRAFFIC_STATS_INTERVAL={{ deploy_app_stack_traffic_stats_interval | default(300) }}
# Per-user учёт: тот же тик копит байты в Subscription.traffic_used_bytes —
# шкала трафика в VPN-клиенте, обнуляется продлением. 0 — аварийный стоп
# только учёта (сбор по нодам продолжается).
TRAFFIC_USER_ACCOUNTING={{ deploy_app_stack_traffic_user_accounting | default(1) }}

# Phase C — bot health-ping with consent. Worker queues a friendly
# "помогите нам улучшить сервис" prompt to active users раз в
# [DEBOUNCE_HOURS, DEBOUNCE_HOURS + DEBOUNCE_JITTER_HOURS] на юзера
# (random per-user forward-stretch у last_at). Дефолт 168+168 = 7-14
# дней — чтобы юзеры не уставали и реальные «не работает» не тонули
# в шуме. Bot удаляет ack-сообщение через HEALTH_PING_ACK_DELETE_DELAY_S.
# Set USER_HEALTH_PING_INTERVAL=0 to disable entirely.
USER_HEALTH_PING_INTERVAL={{ deploy_app_stack_user_health_ping_interval | default(1800) }}
USER_HEALTH_PING_BATCH={{ deploy_app_stack_user_health_ping_batch | default(50) }}
USER_HEALTH_PING_DEBOUNCE_HOURS={{ deploy_app_stack_user_health_ping_debounce_hours | default(168) }}
USER_HEALTH_PING_DEBOUNCE_JITTER_HOURS={{ deploy_app_stack_user_health_ping_debounce_jitter_hours | default(168) }}
HEALTH_PING_ACK_DELETE_DELAY_S={{ deploy_app_stack_health_ping_ack_delete_delay_s | default(60) }}

# Cold-path provisioning throttle — sliding-window limit on cold
# (warm-pool miss) subscription activations. Protects xray nodes
# from bot bursts; migrations and reprovision bypass this cap.
# Surfaces as HTTP 503 + Retry-After to the caller when exhausted.
COLD_PROVISION_MAX_PER_WINDOW={{ deploy_app_stack_cold_provision_max_per_window | default(5) }}
COLD_PROVISION_WINDOW_SECONDS={{ deploy_app_stack_cold_provision_window_seconds | default(60) }}

# ── WS+CDN / xhttp DNS front (Cloudflare DNS-only, no proxy) ───────────
# CF is used ONLY as a DNS host: the backend mints a random DNS-only
# A-record <rand>.wgse.info → node IP; the node serves TLS via Let's
# Encrypt. CF-proxying ws/xhttp is dead (RKN; see project_cf_ws_cdn_dead),
# so the Origin-CA vars are gone.
CLOUDFLARE_DNS_TOKEN={{ deploy_app_stack_cloudflare_dns_token | default('') }}
WSCDN_FRONT_DOMAIN={{ deploy_app_stack_wscdn_front_domain | default('') }}

# ── Provisioning reconciler (desired-state convergence, Phase 2+3) ─────
# Правка ноды бампает desired_generation + debounce-таймер
# (mark_node_dirty) вместо немедленного bootstrap'а; reconcile-тик сходит
# ноды одним coalesced прогоном (cap MAX_PER_TICK, FIFO по due_at), на
# успехе reconciled=desired@start, на фейле due_at+backoff.
# RECONCILER_ENABLED пусто/0 → Phase-0 immediate (фича выключена).
# Включается через deploy_app_stack_reconciler_enabled (group_vars/web).
# Миграция 0043 бэкфилит desired=reconciled=0 → включение НЕ триггерит
# mass-rebuild: реконсайлятся только ноды, правленные ПОСЛЕ включения.
# См. docs/operations/provisioning_reconciler_epic.md.
RECONCILER_ENABLED={{ deploy_app_stack_reconciler_enabled | default('0') }}
RECONCILE_INTERVAL={{ deploy_app_stack_reconcile_interval | default(3) }}
RECONCILE_DEBOUNCE_S={{ deploy_app_stack_reconcile_debounce_s | default(5) }}
RECONCILE_MAX_PER_TICK={{ deploy_app_stack_reconcile_max_per_tick | default(15) }}
RECONCILE_RETRY_S={{ deploy_app_stack_reconcile_retry_s | default(60) }}
RECONCILE_OVERDUE_WARN_S={{ deploy_app_stack_reconcile_overdue_warn_s | default(120) }}
# Diverse N×M подписка (Phase A): сколько РАЗНООБРАЗНЫХ нод класть в саб юзеру
# (1 = текущее однонодовое поведение). >1 ⇒ provision дотягивает тёплые бандлы с
# доп. нод к тому же device, клиент прыгает между нодами (Auto/url-test).
DIVERSE_SUB_NODES={{ deploy_app_stack_diverse_sub_nodes | default(1) }}
# Phase B — HAPP auto-select заголовки сабы (subscription-autoconnect+lowestdelay).
# "off" (дефолт) = никому; "all" = всем; CSV user_id'ов = обкатка на одном юзере.
SUB_HAPP_AUTOCONNECT={{ deploy_app_stack_sub_happ_autoconnect | default('off') }}
# Опц. доп.фильтр «только НОВЫЕ девайсы»: ISO-метка, включаем autoconnect лишь для
# девайсов с created_at >= метки (тест без путаницы со старыми/primary). Пусто = все.
SUB_HAPP_AUTOCONNECT_SINCE={{ deploy_app_stack_sub_happ_autoconnect_since | default('') }}
# Аварийный рубильник: выкинуть из саб-выдачи креды протоколов без split-tunnel
# на relay-нодах. Штатно ВЫКЛЮЧЕН — каждый протокол туннелируется сам. Включать
# (1), если ansible-раскатка split-tunnel где-то не прошла и слепые эндпоинты
# надо убрать из выдачи раньше, чем починится нода.
SUB_FILTER_TUNNEL_BLIND={{ deploy_app_stack_sub_filter_tunnel_blind | default(0) }}
# Рубильник фильтра нездоровых нод (cooldown/декоммишен/низкий health_score).
SUB_FILTER_UNHEALTHY_NODES={{ deploy_app_stack_sub_filter_unhealthy_nodes | default(1) }}
# ── Набор эндпоинтов 4×1 (docs/operations/subset_epic_2026_07_29.md) ────────
# legacy = как было (в саб идут ВСЕ протоколы всех нод девайса, 12 строк);
# 4x1 = с каждой ноды публикуется одна роль. Переключение — только этот флаг:
# креды на нодах и warm-пул схема не трогает, откат = вернуть legacy + рестарт.
SUB_LEG_SCHEME={{ deploy_app_stack_sub_leg_scheme | default('legacy') }}
# Сколько РАЗНЫХ нод собирать в набор (по одной роли с каждой).
SUB_LEG_NODES={{ deploy_app_stack_sub_leg_nodes | default(4) }}
# Потолок дублей на устройство: дубль выдаётся по эскалации тому, у кого живёт
# один протокол, и стоит лишнего крела на ноде — раздавать всем незачем.
SUB_LEG_DUP_MAX={{ deploy_app_stack_sub_leg_dup_max | default(1) }}
# ── Xray-JSON вместо списка ссылок (фейловер внутри сессии) ────────────────
# off (дефолт) = все получают прежнее base64-тело; allowlist = JSON едет только
# токенам из SUB_XRAY_JSON_TOKENS; on = всем клиентам, которые его читают
# (Happ, v2rayTun). Формат меняет ВЕСЬ профиль в клиенте, поэтому обкатка
# идёт пер-токенно. hy2-леги в JSON не переносятся (obfs невыразим), при
# менее чем двух vless-легах ветка сама падает на плоский список.
SUB_XRAY_JSON={{ deploy_app_stack_sub_xray_json | default('off') }}
# CSV саб-токенов для режима allowlist.
SUB_XRAY_JSON_TOKENS={{ deploy_app_stack_sub_xray_json_tokens | default('') }}
# Кому из УМЕЮЩИХ клиентов реально отдаём (happ, v2raytun). Отдельно от режима:
# «формат клиент понимает» и «мы проверили на живом устройстве» — разное.
# Пусто = всем умеющим.
SUB_XRAY_JSON_CLIENTS={{ deploy_app_stack_sub_xray_json_clients | default('') }}
# Порт-хоппинг hy2 в Xray-JSON: off (дефолт) / all / CSV саб-токенов.
# 🔴 Упирается в НОДУ, а не в клиента: пакет на порт из диапазона доедет только
# там, где стоит DNAT-правило hy2-port-hopping. На 2026-08-25 оно было не на
# всех нодах (не переживает ребут без netfilter-persistent) — включение
# вслепую превращает рабочий hy2-лег в молчащий. Сперва проверить ноды.
SUB_XRAY_HY2_HOP={{ deploy_app_stack_sub_xray_hy2_hop | default('off') }}
# Клиентское правило ru-direct в Xray-JSON: off (дефолт) / all / CSV саб-токенов.
# РУ-зоны и домены (тот же список, что в роли ru_direct_list) уходят с реального
# IP человека мимо VPN — на ЛЮБОМ леге. Зачем, если split уже есть на ноде: на
# direct-нодах без WG-туннеля (vsin-nl-01, 4vds-dk-01) разделять нечего, всё
# уходит с IP ноды, и РУ-сервисы видят датский/голландский адрес; hy2 per-user
# split не умеет вовсе. Эффект — на рефреше сабы; откат = off + прокат.
SUB_XRAY_RU_DIRECT={{ deploy_app_stack_sub_xray_ru_direct | default('off') }}
# Период пинг-пробы балансировщика, секунды. Это ТРАФИК: ядро дёргает каждый
# лег раз в N секунд, и каждая проба — полноценный TLS-хендшейк через ноду.
# 300 = ~180 МБ/мес на устройство при трёх легах. Меньше 30 не ставится.
SUB_XRAY_PROBE_INTERVAL_S={{ deploy_app_stack_sub_xray_probe_interval_s | default(300) }}
# Окно, в котором жалобы «VPN не работает» считаются одной серией (лестница
# ротации: перетасовка → смена нод → дубль). Сутки: жалоба неделю спустя —
# новая история, и начинать её надо снова с дешёвого шага.
ROTATION_LADDER_WINDOW_SEC={{ deploy_app_stack_rotation_ladder_window_sec | default(86400) }}
# Схлопывание ДРЕБЕЗГА (человек нетерпелив и жмёт кнопку дважды подряд). Это не
# троттл: троттл ограничивает действие, а тут одна жалоба вместо двух.
COMPLAINT_DEDUP_SEC={{ deploy_app_stack_complaint_dedup_sec | default(60) }}
# Блок статуса подписки в VPN-клиенте (срок + кнопка «Продлить»). Русский текст
# уезжает как base64: — форма Happ; отрисовку делает чужой клиент, и если он
# покажет абракадабру, выключение обязано стоить переменную, а не откат релиза.
SUB_STATUS_BANNER={{ deploy_app_stack_sub_status_banner | default(1) }}
# Provider ID из кабинета happ-proxy.com, привязан к домену саб-ссылки
# (grn-ssync.pro). Без него Happ молча игнорирует ВЕСЬ Advanced-слой:
# sub-info-блок, sub-expire-баннер, пуши об истечении.
HAPP_PROVIDER_ID={{ deploy_app_stack_happ_provider_id | default('') }}
# announce — Standard-блок статуса Happ, работает без providerid.
# auto = слать, пока providerid не задан (иначе дубль с sub-info);
# 1 = слать всегда; 0 = никогда.
SUB_STATUS_ANNOUNCE={{ deploy_app_stack_sub_status_announce | default('auto') }}
# Страница «починить и продлить» без Telegram на домене саб-ссылки (?fix=1).
# Рубильник: 0 — любой ?fix отдаёт camo-лендинг, поведение выдачи не меняется.
SUB_FIX_PAGE={{ deploy_app_stack_sub_fix_page | default(0) }}
# Блок продления на странице (счёт lava.top картой, без Telegram).
SUB_FIX_PAY={{ deploy_app_stack_sub_fix_pay | default(0) }}
# Какие слоты в VPN-клиенте ведут на страницу: off / support / all.
# support — иконка поддержки; all — плюс кнопки блока статуса и предупреждения
# об истечении (у истёкшей подписки это единственная видимая кнопка).
SUB_FIX_ENTRYPOINTS={{ deploy_app_stack_sub_fix_entrypoints | default('off') }}
# Окно, в котором повторный POST со страницы вернёт «уже переключили».
SUB_FIX_THROTTLE_SEC={{ deploy_app_stack_sub_fix_throttle_sec | default(120) }}
# Потолок починок с этого источника на устройство в сутки (утёкший токен).
SUB_FIX_DAILY_MAX={{ deploy_app_stack_sub_fix_daily_max | default(5) }}
# Единая политика повторов «VPN не работает» для ВСЕХ каналов (бот, кабинет,
# страница по токену, ответ «плохо» на плановый пинг): окно, в котором
# повторная жалоба по подписке отвечает «уже переключали», и потолок починок
# подписки в сутки. По умолчанию наследуют SUB_FIX_* выше.
SELF_REPAIR_THROTTLE_SEC={{ deploy_app_stack_self_repair_throttle_sec | default(deploy_app_stack_sub_fix_throttle_sec | default(120)) }}
SELF_REPAIR_DAILY_MAX={{ deploy_app_stack_self_repair_daily_max | default(deploy_app_stack_sub_fix_daily_max | default(5)) }}
# Провайдер оплаты со страницы (карта без Telegram). Пусто = lava_top.
SUB_FIX_PROVIDER={{ deploy_app_stack_sub_fix_provider | default('lava_top') }}
# Провайдер кнопки «Продлить по СБП» (&pay=sbp). Пусто = lava_top_sbp.
SUB_FIX_SBP_PROVIDER={{ deploy_app_stack_sub_fix_sbp_provider | default('lava_top_sbp') }}
# Короткое имя мини-аппа из BotFather. Задано → кнопки в VPN-клиенте открывают
# личный кабинет одним тапом (t.me/<bot>/<short_name>); пусто → deep-link в
# бота, где он отвечает сообщением с кнопкой входа (WebApp из внешнего
# браузера открыть нельзя, только изнутри Telegram).
TELEGRAM_MINIAPP_SHORT_NAME={{ deploy_app_stack_miniapp_short_name | default('') }}
# Cloud-billing guard (баланс провайдеров + стоимость флота).
CLOUD_BILLING_INTERVAL={{ deploy_app_stack_cloud_billing_interval | default(3600) }}
CLOUD_BALANCE_ALERT_THRESHOLD={{ deploy_app_stack_cloud_balance_alert_threshold | default(0) }}
# AI-агент (read-only диагностический триаж, AI_AGENT_ROADMAP Phase 1).
AGENT_ENABLED={{ deploy_app_stack_agent_enabled | default('') }}
ANTHROPIC_API_KEY={{ deploy_app_stack_anthropic_api_key | default('') }}
AGENT_MODEL={{ deploy_app_stack_agent_model | default('claude-sonnet-4-6') }}
