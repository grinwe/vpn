# {{ ansible_managed }}
#
# Rendered by roles/deploy_app_stack. Do not edit by hand on the host
# — changes will be overwritten on the next ansible-playbook run.
# Change values via group_vars/<group>/vault.yml instead.

APP_ENV={{ deploy_app_stack_app_env | default('production') }}

# Admin SPA base path — подставляется в docker-compose как
# VITE_ADMIN_BASE_PATH (build-arg) и ADMIN_BASE_PATH (runtime env
# для nginx envsubst). Менять через vault_admin_secret_path в
# group_vars/web/vault.yml; смена требует ребилда admin-контейнера.
ADMIN_BASE_PATH={{ deploy_app_stack_admin_base_path | default('admin') }}

POSTGRES_PASSWORD={{ deploy_app_stack_postgres_password }}
DATABASE_URL=postgresql+psycopg2://vpn:{{ deploy_app_stack_postgres_password }}@db:5432/vpn

ADMIN_API_TOKEN={{ deploy_app_stack_admin_api_token }}
APP_SECRET_KEY={{ deploy_app_stack_app_secret_key }}

# Structured logging: "json" for prod log aggregators, "console" for dev.
LOG_FORMAT={{ deploy_app_stack_log_format | default('json') }}
LOG_LEVEL={{ deploy_app_stack_log_level | default('INFO') }}

BOT_TOKEN={{ deploy_app_stack_bot_token }}
# Public @username of the bot (without the @), used by the backend to
# build the referral share link (https://t.me/<username>?start=ref_...).
BOT_USERNAME={{ deploy_app_stack_bot_username }}
ADMIN_IDS={{ deploy_app_stack_admin_ids }}

PAYMENT_PROVIDER={{ deploy_app_stack_payment_provider }}
# Stage 9a — comma-separated rotation pool. When set, the backend
# picks one provider per checkout. Leave empty to keep single-provider
# behaviour from PAYMENT_PROVIDER above.
PAYMENT_PROVIDERS={{ deploy_app_stack_payment_providers | default('') }}
TELEGRAM_STARS_WEBHOOK_SECRET={{ deploy_app_stack_telegram_stars_webhook_secret }}

# #62 — Telegram native webhook mode. When all three vars are set, the
# backend registers itself as the Bot API webhook receiver on startup,
# processes Stars payments directly, and forwards other updates to the
# bot over the Docker network. Eliminates the shared-secret forwarding.
TELEGRAM_WEBHOOK_SECRET_TOKEN={{ deploy_app_stack_telegram_webhook_secret_token | default('') }}
TELEGRAM_WEBHOOK_URL={{ deploy_app_stack_telegram_webhook_url | default('') }}
BOT_INTERNAL_WEBHOOK_URL={{ deploy_app_stack_bot_internal_webhook_url | default('http://bot:8081/webhook') }}
BOT_WEBHOOK_PORT={{ deploy_app_stack_bot_webhook_port | default(0) }}

# Telegram WebApp
WEBAPP_BASE_URL={{ deploy_app_stack_webapp_base_url }}
WEBAPP_JWT_SECRET={{ deploy_app_stack_webapp_jwt_secret }}
WEBAPP_JWT_TTL_SECONDS={{ deploy_app_stack_webapp_jwt_ttl_seconds }}
# #53 — Telegram initData handshake TTL. 300s default matches Telegram's
# recommended validation window; bounds the replay window if initData
# ever leaks. Do NOT confuse with WEBAPP_JWT_TTL_SECONDS (session JWT).
WEBAPP_INIT_DATA_TTL_SECONDS={{ deploy_app_stack_webapp_init_data_ttl_seconds | default(300) }}

# Path on the host to the SSH private key the worker uses for ansible
# against VPN nodes. Points at the file that tasks/main.yml installed
# (or /dev/null if no key was supplied — see compose's default).
PROVISIONING_SSH_KEY={{ deploy_app_stack_provisioning_key_dst if deploy_app_stack_provisioning_key_src | length > 0 else '/dev/null' }}

# Stage 4 — balance billing tunables. Override per-environment via
# group_vars if you want a different freeze cap, referral bonus or
# minimum topup; the defaults match the WebApp/bot copy ("заморозка
# 14 дней", "+50 ₽ другу", "минимум 100 ₽").
BALANCE_CHARGE_INTERVAL={{ deploy_app_stack_balance_charge_interval | default(3600) }}
FREEZE_DAYS={{ deploy_app_stack_freeze_days | default(14) }}
REFERRAL_BONUS_KOPECKS={{ deploy_app_stack_referral_bonus_kopecks | default(5000) }}
MIN_TOPUP_KOPECKS={{ deploy_app_stack_min_topup_kopecks | default(10000) }}
EXTRA_DEVICE_KOPECKS_PER_MONTH={{ deploy_app_stack_extra_device_kopecks_per_month | default(10000) }}
# Stage 8 — boring-domain proxy URL for the dynamic sub link. Leave
# empty to keep relative-path behavior, or point at a Cloudflare
# Worker / separate domain so blocked-grinwer.online doesn't kill
# already-installed clients. Example: https://c1.cloudfn.app/sub
SUB_LINK_BASE_URL={{ deploy_app_stack_sub_link_base_url | default('') }}
LOW_BALANCE_WARN_DAYS={{ deploy_app_stack_low_balance_warn_days | default(3) }}

# Self-heal tick for provisioning tasks stuck in ``pending`` because the
# RQ enqueue call hit a transient error at creation time. Scans every
# PENDING_RESCUE_INTERVAL seconds and re-enqueues any pending task
# older than PENDING_RESCUE_AGE seconds; dedupe on job_id means
# already-queued tasks are no-ops. Set INTERVAL=0 to disable.
PENDING_RESCUE_INTERVAL={{ deploy_app_stack_pending_rescue_interval | default(60) }}
PENDING_RESCUE_AGE={{ deploy_app_stack_pending_rescue_age | default(60) }}

# Subprocess timeout (seconds) for `ansible-playbook` runs. Bump if
# nodes with slow package installs routinely hit the default 5-min cap.
ANSIBLE_PLAYBOOK_TIMEOUT={{ deploy_app_stack_ansible_playbook_timeout | default(300) }}

# Phase A — probe-agent (active TCP/TLS prober co-located with the
# backend on this host). Mint the token via:
#   curl -sS -X POST \
#     -H "X-Admin-Token: $ADMIN_API_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"name":"probe-nl-web","scopes":["probe:read","probe:write"]}' \
#     http://127.0.0.1:8000/api/api-tokens
# Then store the returned plaintext as vault_probe_agent_token in
# group_vars/web/vault.yml and re-run the playbook. Empty token means
# the probe-agent container restart-loops on 401 — harmless but noisy.
PROBE_AGENT_TOKEN={{ deploy_app_stack_probe_agent_token | default('') }}
PROBE_AGENT_REGION={{ deploy_app_stack_probe_agent_region | default('eu-nl') }}
PROBE_AGENT_INTERVAL={{ deploy_app_stack_probe_agent_interval | default(60) }}
PROBE_AGENT_TIMEOUT={{ deploy_app_stack_probe_agent_timeout | default(5) }}
PROBE_AGENT_CONCURRENCY={{ deploy_app_stack_probe_agent_concurrency | default(16) }}

# Phase B — passive xray traffic stats collector. Worker SSHs into
# each active node every TRAFFIC_STATS_INTERVAL seconds and writes
# uplink/downlink/active_users into node_traffic_samples. 0 disables.
TRAFFIC_STATS_INTERVAL={{ deploy_app_stack_traffic_stats_interval | default(300) }}

# Phase C — bot health-ping with consent. Worker queues a friendly
# "помогите нам улучшить сервис" prompt to active users раз в
# [DEBOUNCE_HOURS, DEBOUNCE_HOURS + DEBOUNCE_JITTER_HOURS] на юзера
# (random per-user forward-stretch у last_at). Дефолт 168+168 = 7-14
# дней — чтобы юзеры не уставали и реальные «не работает» не тонули
# в шуме. Bot удаляет ack-сообщение через HEALTH_PING_ACK_DELETE_DELAY_S.
# Set USER_HEALTH_PING_INTERVAL=0 to disable entirely.
USER_HEALTH_PING_INTERVAL={{ deploy_app_stack_user_health_ping_interval | default(1800) }}
USER_HEALTH_PING_BATCH={{ deploy_app_stack_user_health_ping_batch | default(50) }}
USER_HEALTH_PING_DEBOUNCE_HOURS={{ deploy_app_stack_user_health_ping_debounce_hours | default(168) }}
USER_HEALTH_PING_DEBOUNCE_JITTER_HOURS={{ deploy_app_stack_user_health_ping_debounce_jitter_hours | default(168) }}
HEALTH_PING_ACK_DELETE_DELAY_S={{ deploy_app_stack_health_ping_ack_delete_delay_s | default(60) }}

# Cold-path provisioning throttle — sliding-window limit on cold
# (warm-pool miss) subscription activations. Protects xray nodes
# from bot bursts; migrations and reprovision bypass this cap.
# Surfaces as HTTP 503 + Retry-After to the caller when exhausted.
COLD_PROVISION_MAX_PER_WINDOW={{ deploy_app_stack_cold_provision_max_per_window | default(5) }}
COLD_PROVISION_WINDOW_SECONDS={{ deploy_app_stack_cold_provision_window_seconds | default(60) }}
