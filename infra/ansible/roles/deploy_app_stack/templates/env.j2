# {{ ansible_managed }}
#
# Rendered by roles/deploy_app_stack. Do not edit by hand on the host
# — changes will be overwritten on the next ansible-playbook run.
# Change values via group_vars/<group>/vault.yml instead.

POSTGRES_PASSWORD={{ deploy_app_stack_postgres_password }}
DATABASE_URL=postgresql+psycopg2://vpn:{{ deploy_app_stack_postgres_password }}@db:5432/vpn

ADMIN_API_TOKEN={{ deploy_app_stack_admin_api_token }}
APP_SECRET_KEY={{ deploy_app_stack_app_secret_key }}

BOT_TOKEN={{ deploy_app_stack_bot_token }}
# Public @username of the bot (without the @), used by the backend to
# build the referral share link (https://t.me/<username>?start=ref_...).
BOT_USERNAME={{ deploy_app_stack_bot_username }}
ADMIN_IDS={{ deploy_app_stack_admin_ids }}

PAYMENT_PROVIDER={{ deploy_app_stack_payment_provider }}
# Stage 9a — comma-separated rotation pool. When set, the backend
# picks one provider per checkout. Leave empty to keep single-provider
# behaviour from PAYMENT_PROVIDER above.
PAYMENT_PROVIDERS={{ deploy_app_stack_payment_providers | default('') }}
TELEGRAM_STARS_WEBHOOK_SECRET={{ deploy_app_stack_telegram_stars_webhook_secret }}

# Telegram WebApp
WEBAPP_BASE_URL={{ deploy_app_stack_webapp_base_url }}
WEBAPP_JWT_SECRET={{ deploy_app_stack_webapp_jwt_secret }}
WEBAPP_JWT_TTL_SECONDS={{ deploy_app_stack_webapp_jwt_ttl_seconds }}

# Path on the host to the SSH private key the worker uses for ansible
# against VPN nodes. Points at the file that tasks/main.yml installed
# (or /dev/null if no key was supplied — see compose's default).
PROVISIONING_SSH_KEY={{ deploy_app_stack_provisioning_key_dst if deploy_app_stack_provisioning_key_src | length > 0 else '/dev/null' }}

# Stage 4 — balance billing tunables. Override per-environment via
# group_vars if you want a different freeze cap, referral bonus or
# minimum topup; the defaults match the WebApp/bot copy ("заморозка
# 14 дней", "+50 ₽ другу", "минимум 100 ₽").
BALANCE_CHARGE_INTERVAL={{ deploy_app_stack_balance_charge_interval | default(3600) }}
MAX_FREEZE_DAYS_PER_PERIOD={{ deploy_app_stack_max_freeze_days_per_period | default(14) }}
FREEZE_YEAR_BUDGET_DAYS={{ deploy_app_stack_freeze_year_budget_days | default(30) }}
REFERRAL_BONUS_KOPECKS={{ deploy_app_stack_referral_bonus_kopecks | default(5000) }}
MIN_TOPUP_KOPECKS={{ deploy_app_stack_min_topup_kopecks | default(10000) }}
EXTRA_DEVICE_KOPECKS_PER_MONTH={{ deploy_app_stack_extra_device_kopecks_per_month | default(10000) }}
# Stage 8 — boring-domain proxy URL for the dynamic sub link. Leave
# empty to keep relative-path behavior, or point at a Cloudflare
# Worker / separate domain so blocked-grinwer.online doesn't kill
# already-installed clients. Example: https://c1.cloudfn.app/sub
SUB_LINK_BASE_URL={{ deploy_app_stack_sub_link_base_url | default('') }}
LOW_BALANCE_WARN_DAYS={{ deploy_app_stack_low_balance_warn_days | default(3) }}

# Stage 5 — autoscale downscale. Off by default; flip the switch once
# the metrics for evaluate_pool_downscale look sane. low_watermark MUST
# stay well below high_watermark to avoid flapping.
AUTOSCALE_DOWNSCALE_ENABLED={{ deploy_app_stack_autoscale_downscale_enabled | default(0) }}
AUTOSCALE_LOW_WATERMARK={{ deploy_app_stack_autoscale_low_watermark | default('0.3') }}
AUTOSCALE_MIN_NODES={{ deploy_app_stack_autoscale_min_nodes | default(1) }}
AUTOSCALE_DRAIN_GRACE_HOURS={{ deploy_app_stack_autoscale_drain_grace_hours | default(24) }}
DRAIN_TICK_INTERVAL={{ deploy_app_stack_drain_tick_interval | default(600) }}
DRAIN_MIGRATE_BATCH={{ deploy_app_stack_drain_migrate_batch | default(10) }}
