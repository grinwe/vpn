# {{ ansible_managed }}
#
# Rendered by roles/deploy_app_stack. Do not edit by hand on the host
# — changes will be overwritten on the next ansible-playbook run.
# Change values via group_vars/<group>/vault.yml instead.

POSTGRES_PASSWORD={{ deploy_app_stack_postgres_password }}
DATABASE_URL=postgresql+psycopg2://vpn:{{ deploy_app_stack_postgres_password }}@db:5432/vpn

ADMIN_API_TOKEN={{ deploy_app_stack_admin_api_token }}
APP_SECRET_KEY={{ deploy_app_stack_app_secret_key }}

BOT_TOKEN={{ deploy_app_stack_bot_token }}
ADMIN_IDS={{ deploy_app_stack_admin_ids }}

PAYMENT_PROVIDER={{ deploy_app_stack_payment_provider }}
TELEGRAM_STARS_WEBHOOK_SECRET={{ deploy_app_stack_telegram_stars_webhook_secret }}

# Telegram WebApp
WEBAPP_BASE_URL={{ deploy_app_stack_webapp_base_url }}
WEBAPP_JWT_SECRET={{ deploy_app_stack_webapp_jwt_secret }}
WEBAPP_JWT_TTL_SECONDS={{ deploy_app_stack_webapp_jwt_ttl_seconds }}

# Path on the host to the SSH private key the worker uses for ansible
# against VPN nodes. Points at the file that tasks/main.yml installed
# (or /dev/null if no key was supplied — see compose's default).
PROVISIONING_SSH_KEY={{ deploy_app_stack_provisioning_key_dst if deploy_app_stack_provisioning_key_src | length > 0 else '/dev/null' }}
