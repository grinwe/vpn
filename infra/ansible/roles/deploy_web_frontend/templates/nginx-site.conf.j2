# {{ ansible_managed }}
#
# Single-domain nginx vhost: {{ deploy_web_frontend_domain }} terminates
# TLS on the host and proxies three loopback upstreams:
#   /{{ deploy_web_frontend_admin_path }}/   -> admin SPA container (docker, {{ deploy_web_frontend_admin_upstream }})
#   /app/    -> Telegram WebApp container     (docker, {{ deploy_web_frontend_webapp_upstream }})
#   /api/    -> backend FastAPI               (docker, {{ deploy_web_frontend_api_upstream }})
# Всё остальное — camo-landing (см. anti-probing план / stage 3).
#
# TLS cert is obtained via certbot DNS-01 challenge against Cloudflare
# (see tasks/main.yml). Certificate paths below are Let's Encrypt's
# canonical locations; certbot.timer renews in place with zero config
# drift here.
#
# The domain sits behind Cloudflare's proxy. CF runs in SSL mode
# Full (strict), so CF → origin also happens over TLS using this exact
# certificate. Do NOT switch CF to Flexible — you'll get a redirect
# loop because nginx below redirects HTTP → HTTPS.

# HTTP: only exists to redirect to HTTPS. Let's Encrypt DNS-01 does
# not need port 80 at all; this vhost is purely for users who type the
# bare URL.
server {
    listen 80;
    listen [::]:80;
    server_name {{ deploy_web_frontend_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ deploy_web_frontend_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ deploy_web_frontend_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ deploy_web_frontend_domain }}/privkey.pem;

    # Mozilla Intermediate profile (2024-ish): TLS 1.2 + 1.3 only,
    # modern ciphers, OCSP stapling off because CF caches OCSP itself.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Strip the nginx version from the Server: header so an active
    # prober can't fingerprint the exact build. `proxy_hide_header` in
    # each proxy location below drops upstream Server/X-Powered-By for
    # the same reason (ngx_headers_more is not guaranteed to be built
    # in, so we use the stock directives).
    server_tokens off;

    # HSTS. CF also sets it, but belt-and-braces — if someone ever
    # points straight at origin bypassing CF, this still applies.
    add_header Strict-Transport-Security "max-age=15768000" always;

    # Small safety cap on request body so a single bad webhook can't
    # eat the box. Backend's largest legit body is the manual-mark
    # invoice JSON, well under 1 MB.
    client_max_body_size 2m;

    # Telegram WebApp (Mini App) SPA. Same proxy pattern as /admin/ —
    # the webapp container serves its bundle under /app/ so asset URLs
    # built with `base: "/app/"` resolve correctly.
    location /app/ {
        proxy_pass http://{{ deploy_web_frontend_webapp_upstream }}/app/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # Admin SPA за secret path'ом (см. deploy_web_frontend_admin_path).
    # По дефолту — /admin/. Если задан vault_admin_secret_path, сюда
    # приходит /mgmt-<hex>/; admin-контейнер внутри собран с тем же
    # base'ом и отдаёт статику по этому префиксу, поэтому proxy_pass
    # проксирует как есть (trailing slash сохраняет префикс).
    #
    # Ссылаться на старый /admin/ снаружи после переключения бесполезно —
    # попадёт в camo-landing ниже (404 от root catch-all).
    #
    # Referrer-Policy — external-ссылки из админки (логи, интерком и
    # т.п.) не должны утекать полный URL с secret-путём в чужие логи.
    location /{{ deploy_web_frontend_admin_path }}/ {
        proxy_pass http://{{ deploy_web_frontend_admin_upstream }}/{{ deploy_web_frontend_admin_path }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
        add_header Referrer-Policy "same-origin" always;
    }

    # Backend API. proxy_pass without a trailing slash preserves the
    # /api/* path so FastAPI's own /api/* routes match.
    location /api/ {
        proxy_pass http://{{ deploy_web_frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # #62 — Telegram Bot API webhook. Telegram sends updates here
    # instead of the bot polling. The backend validates the secret_token
    # header, processes payments directly, and forwards the rest to the
    # bot over the internal Docker network.
    location = /tg-webhook {
        proxy_pass http://{{ deploy_web_frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # Dynamic subscription link endpoint — lives outside /api/ by
    # design so the URL users paste into Hiddify/v2rayNG stays short
    # (https://{{ deploy_web_frontend_domain }}/sub/<token>).
    location /sub/ {
        proxy_pass http://{{ deploy_web_frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # Camo-landing на всё, что не /app/, /{admin_path}/, /api/, /sub/,
    # /tg-webhook. До stage-3 здесь был голый 404 — активные проберы
    # получали пустой корень как VPN-маркер. Теперь скучный «internal
    # tools portal» с 200, чтобы нас путали с корпоративным фронтом.
    location / {
        root {{ deploy_web_frontend_camo_root }};
        index index.html;
        try_files $uri $uri/ /index.html =404;
    }
}
