# {{ ansible_managed }}
#
# Single-domain nginx vhost: grinwer.online terminates TLS on the host
# and proxies two loopback upstreams:
#   /admin/  -> admin SPA container (docker, 127.0.0.1:8080)
#   /api/    -> backend FastAPI      (docker, 127.0.0.1:8000)
#
# On first run this file is HTTP-only; certbot --nginx rewrites it to
# add listen 443 + SSL cert paths + an HTTP->HTTPS redirect. Subsequent
# ansible runs will re-render the HTTP skeleton, and certbot patches it
# again idempotently (no downtime because the cert on disk survives).

server {
    listen 80;
    listen [::]:80;
    server_name {{ deploy_web_frontend_domain }};

    # Small safety cap on request body so a single bad webhook can't
    # eat the box. Backend's largest legit body is the manual-mark
    # invoice JSON, well under 1 MB.
    client_max_body_size 2m;

    # Root -> /admin/ for convenience.
    location = / {
        return 302 /admin/;
    }

    # Admin SPA. trailing slash on both sides preserves the /admin/
    # prefix so the bundled asset URLs (base: "/admin/") resolve.
    location /admin/ {
        proxy_pass http://{{ deploy_web_frontend_admin_upstream }}/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API. Note: we intentionally strip the /api prefix when
    # proxying because the FastAPI routes already live under /api/*,
    # so proxy_pass without a trailing slash preserves the path.
    location /api/ {
        proxy_pass http://{{ deploy_web_frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Block anything else — no static site, no root index. Keeps the
    # surface small.
    location / {
        return 404;
    }
}
