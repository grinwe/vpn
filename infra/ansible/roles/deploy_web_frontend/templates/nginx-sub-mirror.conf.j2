# {{ ansible_managed }}
#
# Зеркало саб-линка на {{ deploy_web_frontend_sub_mirror_domain }} — дубль
# grn-ssync.pro, но БЕЗ Cloudflare в пути данных.
#
# Зачем. Основной фронт саб-линка — CF Worker `v8-sub` на grn-ssync.pro
# (см. docs/operations/worker-v8-sub.md). У части юзеров он не открывается,
# и пока непонятно, бан это по домену или сетевая беда на стороне CF.
# Зеркало даёт второй адрес на принципиально другом IP (наш origin), чтобы
# отличить одно от другого и иметь запасной путь.
#
# ВАЖНО: `listen 443 ssl;` БЕЗ http2 — намеренно. RKN DPI на 4G режет
# HTTP/2-stream после TLS-handshake: заголовки доходят, тело теряется.
# На CF это гасится тумблером (только с Pro), здесь — просто не включаем.
# Не добавляй сюда http2/http3, даже если очень хочется ускорить.
#
# Домен ОБЯЗАН быть DNS-only в Cloudflare (серое облачко). Оранжевое
# вернёт CF в путь данных и убьёт весь смысл зеркала.
#
# Маппинг повторяет воркер один-в-один:
#   https://{{ deploy_web_frontend_sub_mirror_domain }}/<token>  ->  backend /api/sub/<token>
# Query-строка пробрасывается целиком — без неё отваливаются ?fix=1,
# ?fmt=plain и ?userinfo=expire.

server {
    listen 80;
    listen [::]:80;
    server_name {{ deploy_web_frontend_sub_mirror_domain }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ deploy_web_frontend_sub_mirror_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ deploy_web_frontend_sub_mirror_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ deploy_web_frontend_sub_mirror_domain }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=15768000" always;
    client_max_body_size 1m;

    # Ровно один сегмент-токен, как в TOKEN_RE воркера. GET отдаёт саб или
    # страницу ?fix=1, POST — действия починки (в отличие от воркера тело
    # POST сюда доезжает, форма работает без оговорок).
    location ~ ^/(?<subtoken>[A-Za-z0-9_-]{20,80})/?$ {
        proxy_pass http://{{ deploy_web_frontend_api_upstream }}/api/sub/$subtoken$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # Всё прочее — тот же camo-landing, что и на основном домене: голый 404
    # на корне читается пробером как VPN-маркер.
    location / {
        root {{ deploy_web_frontend_camo_root }};
        index index.html;
        try_files $uri $uri/ /index.html =404;
    }
}
