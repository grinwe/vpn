---
# Rendered by ansible role monitoring_stack. Do not edit by hand.

services:
  prometheus:
    image: {{ monitoring_stack_prometheus_image }}
    container_name: vpn-prometheus
    restart: unless-stopped
    # Prometheus присоединяется к внешней docker-сети backend'а
    # ({{ monitoring_stack_backend_network }}), чтобы scrape'ить бэкенд
    # по container-DNS ``backend:8000``. На Linux ``host.docker.internal``
    # резолвится в IP docker-bridge gateway, а backend биндится
    # на 127.0.0.1 хоста — это разные интерфейсы, connection refused.
    # Co-location monitoring+web обязательна для этой схемы (one host,
    # one docker daemon). Если стеки разъедутся на разные машины —
    # убрать ``{{ monitoring_stack_backend_network }}`` из networks
    # + override ``monitoring_stack_backend_metrics_url`` в IP:port
    # + открыть firewall.
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=30d"
      - "--web.enable-lifecycle"  # enables SIGHUP/reload handler
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./data/prometheus:/prometheus
    ports:
      - "{{ monitoring_stack_prometheus_bind }}:9090"
    networks:
      - default
      - backend_net

  grafana:
    image: {{ monitoring_stack_grafana_image }}
    container_name: vpn-grafana
    restart: unless-stopped
    depends_on:
      - prometheus
    environment:
      GF_SECURITY_ADMIN_USER: "{{ monitoring_stack_grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ monitoring_stack_grafana_admin_password }}"
      # Refuse anonymous access — this is a single-operator tool.
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      # Disable telemetry/update checks so the instance doesn't phone home.
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ./data/grafana:/var/lib/grafana
    ports:
      - "{{ monitoring_stack_grafana_bind }}:3000"

networks:
  # ``default`` — обычная сеть monitoring-стека, prometheus ↔ grafana.
  default:
    name: vpn-monitoring_default
  # ``backend_net`` — внешняя ссылка на сеть app-stack'а (создаётся
  # compose'ом под /opt/vpn: проект vpn → сеть ``vpn_default``).
  # external: true означает что compose не создаёт/удаляет её —
  # только подключает prometheus. Имя переопределяется переменной
  # monitoring_stack_backend_network для multi-host сценариев.
  backend_net:
    external: true
    name: {{ monitoring_stack_backend_network }}
