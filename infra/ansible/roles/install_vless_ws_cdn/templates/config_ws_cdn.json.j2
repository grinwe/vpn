{% set _fan_out = xray_relay_outbounds | default([]) %}
{% set _primary = xray_primary_interface | default('') %}
{
  "log": {
    "loglevel": "info",
    "access": "/var/log/xray/access-ws-cdn.log"
  },
  "api": {
    "tag": "api",
    "services": ["StatsService"]
  },
  "stats": {},
  {#- dns + domainStrategy нужны RU-обходу: без них domain-правила ниже
      работают только по отснифанному SNI, а IP-назначения не классифицируются
      вовсе. Порядок резолверов как в reality/xhttp — Яндекс первым, чтобы
      РУ-домены резолвились в РУ-IP и попадали под geoip:ru. -#}
  "dns": {
    "servers": [
      "77.88.8.8",
      "8.8.8.8",
      "1.1.1.1"
    ],
    "queryStrategy": "UseIP"
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api-in"],
        "outboundTag": "api"
      },
      {#- RU-обход. Этот протокол не имел его НИКОГДА (аудит 2026-07-28,
          находка Б1): правил не было, но дефолтный outbound `direct` получает
          sockopt на wgN и из шаблона ниже, и из xray_reconcile.jq — то есть на
          relay-ноде через WG уходил ВЕСЬ трафик, включая российский. Сбер,
          Госуслуги, Ozon/WB, Avito, VK видели турецкий/французский IP → капчи и
          «недоступно в вашем регионе». Бьёт ровно по тем, у кого reality/xhttp
          зарезаны DPI, — то есть по самой нуждающейся в РУ-обходе группе.

          Держать в паритете с reality/xhttp — обоснование каждого куска
          в install_vless_reality/templates/config.json.j2. -#}
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        {#- Список — из роли ru_direct_list (единый на все 4 протокола).
            Зоны рендерим regexp'ами, конкретные домены — `domain:`
            (суффиксный матч: домен + все поддомены). -#}
        "domain": {{ ((ru_direct_zones | map('regex_replace', '^(.*)$', 'regexp:\\\\.\\1$') | list)
                    + (ru_direct_domains | map('regex_replace', '^(.*)$', 'domain:\\1') | list))
                   | to_json }},
        "outboundTag": "direct-local"
      },
      {
        "type": "field",
        "ip": ["geoip:ru"],
        "outboundTag": "direct-local"
      }{% for _rule in _fan_out if _rule.emails %},
      {
        "type": "field",
        "user": {{ _rule.emails | to_json }},
        "outboundTag": "direct-{{ _rule.interface }}"
      }{% endfor %}
    ]
  },
  "inbounds": [
    {
      "tag": "api-in",
      "listen": "127.0.0.1",
      "port": {{ vless_ws_cdn_api_port | default(10086) }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    },
    {
      "tag": "vless-ws-cdn",
      "listen": "127.0.0.1",
      "port": {{ vless_ws_cdn_loopback_port | default(10444) | int }},
      "protocol": "vless",
      "settings": {
        "clients": {{ vless_ws_cdn_existing_clients | default([]) | to_json }},
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "{{ vless_ws_cdn_path }}",
          {#- heartbeatPeriod: xray шлёт WS ping-фреймы каждые N секунд.
              Cloudflare молча рвёт idle-WebSocket на 100с (Free/Pro) → клиент
              ловит close 1006 unexpected EOF. Пинги < 100с держат коннект
              живым. См. developers.cloudflare.com/network/websockets. -#}
          "heartbeatPeriod": {{ vless_ws_cdn_ws_heartbeat | default(30) | int }}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"{% if _primary %},
      "streamSettings": {
        "sockopt": {
          "interface": "{{ _primary }}",
          "tcpKeepAliveInterval": 30
        }
      }{% endif %}
    },
    {#- direct-local — БЕЗ sockopt: это и есть «мимо туннеля, с IP самой
        ноды». Цель RU-правил выше. -#}
    {
      "protocol": "freedom",
      "tag": "direct-local"
    }{% for _ob in _fan_out %},
    {
      "protocol": "freedom",
      "tag": "direct-{{ _ob.interface }}",
      "streamSettings": {
        "sockopt": {
          "interface": "{{ _ob.interface }}",
          "tcpKeepAliveInterval": 30
        }
      }
    }{% endfor %},
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
