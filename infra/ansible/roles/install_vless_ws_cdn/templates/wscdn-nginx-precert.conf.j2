# {{ ansible_managed }}
#
# Минимальный pre-cert vhost для первичной выдачи Let's Encrypt через
# webroot. Содержит только :80 с acme-challenge; всё остальное — 404.
# Цель — поднять nginx и дать certbot'у положить токен под
# /.well-known/acme-challenge/ БЕЗ --standalone (--standalone хочет
# свободный :80, но если на ноде уже что-то слушает эти порты, он
# упадёт). Это временный файл: после issuance tasks/main.yml его
# перекрывает полноценным TLS-vhost'ом с тем же именем.
server {
    listen 80;
    listen [::]:80;
    server_name {{ vless_ws_cdn_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/acme-challenge;
    }

    location / {
        return 404;
    }
}
