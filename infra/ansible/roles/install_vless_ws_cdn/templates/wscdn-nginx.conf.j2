# {{ ansible_managed }}
#
# CF-fronted WS+CDN front.
#   Clients → CF edge (WSS, SNI {{ vless_ws_cdn_domain }})
#           → CF Full(strict) → this nginx :443 (Origin CA cert)
#           → xray-ws @ 127.0.0.1:{{ vless_ws_cdn_loopback_port | default(10444) }}
#
# Origin IP is hidden behind CF; the user↔CF leg rides shared CF edge IPs
# (un-blockable by RKN subnet-flagging — survives where Reality dies).
#
# Own $ws_cdn_connection_upgrade map var so this coexists with the xhttp
# vhost on the same :443 — a duplicate map OUTPUT variable (both naming
# $connection_upgrade) makes nginx refuse to start. Different output var +
# different server_name (SNI) = clean coexistence.

map $http_upgrade $ws_cdn_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # Порт = client-URI port (cfg.port, дефолт 443 = CF edge). origin
    # слушает ровно его, чтобы CF Full(strict) тянул на совпадающий порт.
    listen {{ vless_ws_cdn_port | default(443) }} ssl http2;
    listen [::]:{{ vless_ws_cdn_port | default(443) }} ssl http2;
    server_name {{ vless_ws_cdn_domain }};

    ssl_certificate     /etc/nginx/ssl/wgse-origin.crt;
    ssl_certificate_key /etc/nginx/ssl/wgse-origin.key;

    # Same TLS profile as the xhttp/web fronts so JA3/JA4 don't diverge
    # across our domains.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # server_tokens off → Server: nginx (без версии) — ванильно, не маркер.
    # НЕ ставим more_clear_headers: headers-more 0.37 + nginx 1.24 сегфолтят
    # воркер на КАЖДОМ :443-запросе (подтверждено на ноде); X-Powered-By nginx
    # и так не отдаёт, upstream-заголовки чистит proxy_hide_header ниже.
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # WebSocket upgrade → loopback xray-ws.
    location {{ vless_ws_cdn_path }} {
        proxy_pass http://127.0.0.1:{{ vless_ws_cdn_loopback_port | default(10444) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ws_cdn_connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        # Длинные таймауты: WS-туннель долгоживущий, а xray держит его
        # heartbeat-пингами. 300s рвало idle-сессии раньше CF-таймаута.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
    }

    # Everything else — bare 404 (no VPN marker beyond a vanilla nginx).
    location / {
        return 404;
    }
}
