# vpn/.env.example
#
# Source of truth for all environment variables the backend/bot/worker
# actually read. Keep in sync with the code — if you add a new os.getenv
# in app/, add it here with a comment and a sane default so new deploys
# don't ship with silent surprises. Sections match docker-compose.yml
# service boundaries loosely.

# ────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vpn:change-me@db:5432/vpn
POSTGRES_PASSWORD=change-me

# SQLAlchemy pool tuning. Defaults are safe for ~50 rps backend; bump
# pool_size if you see "QueuePool limit reached" in logs.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# On backend start, run `alembic upgrade head` unless this is 1.
# Set to 1 if you manage migrations out-of-band (CI, manual).
SKIP_MIGRATIONS=0

# ────────────────────────────────────────────────────────────────
# Security
# ────────────────────────────────────────────────────────────────
# Admin API shared secret. Used by bot → backend calls and by the
# Admin UI login. Rotate via a new scoped ApiToken in /admin/tokens
# rather than editing this file on the fly.
ADMIN_API_TOKEN=change-me-to-a-random-string

# Header name that admin UI sends to tag actions in audit_log with
# a human-readable actor (rather than the generic "admin" bot actor).
ADMIN_ACTOR_HEADER=X-Admin-Actor

# Fernet key for encrypting credentials at rest (VPN config text in
# credentials.config_text, provider tokens, etc.). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DO NOT rotate without a re-encryption migration — existing rows
# become unreadable the moment this changes.
APP_SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token_urlsafe-32

# Backend logging level — INFO/DEBUG/WARNING. DEBUG is verbose, keep
# INFO in prod. Affects backend + worker.
LOG_LEVEL=INFO

# SlowAPI rate-limit storage. "memory://" is per-process and fine for
# single-backend deploys; switch to "redis://redis:6379/1" if you run
# multiple backend replicas and want shared rate-limit counters.
SLOWAPI_STORAGE_URI=memory://

# ────────────────────────────────────────────────────────────────
# Telegram Bot
# ────────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Legacy alias read only by services/payments/telegram_stars.py as a
# fallback if BOT_TOKEN isn't set. Normally leave unset.
# TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs who get /admin commands in-bot and
# who receive support-ticket forwards.
ADMIN_IDS=123456789

# Username of the bot (without @) — used to build reply/share links
# like t.me/<bot>?start=... in WebApp referral flow.
BOT_USERNAME=

# How often the bot polls /api/notifications/pending to pick up
# async notifications queued by the worker (trial expiry, balance
# warnings, etc.).
NOTIFICATION_POLL_INTERVAL=10

# Where the bot's internal httpx client points when calling backend.
# Inside docker-compose, "http://backend:8000" is the service name.
# BACKEND_URL=http://backend:8000

# ────────────────────────────────────────────────────────────────
# Redis / RQ (queue backend for provisioning + cron)
# ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# "rq" enables the RQ queue (worker picks up tasks from Redis).
# Anything else forces in-process provisioning (dev/test only).
QUEUE_BACKEND=rq

# RQ queue tuning. Job timeout = hard kill per ansible run — keep it
# longer than your slowest playbook (bootstrap can take ~5min).
RQ_QUEUE=vpn-provisioning
RQ_JOB_TIMEOUT=900
RQ_FAILED_TTL=604800
RQ_RESULT_TTL=86400

# ────────────────────────────────────────────────────────────────
# Ansible / provisioning
# ────────────────────────────────────────────────────────────────
# Path (inside the worker container) to the ed25519 private key that
# ansible uses to SSH into VPN nodes. docker-compose.yml mounts this
# from ${PROVISIONING_SSH_KEY} on the host. If the host path is empty
# or /dev/null, bootstrap of every new node will silently fail — see
# docs/DEPLOY.md "Provisioning SSH key".
PROVISIONING_SSH_KEY=/opt/vpn/secrets/provisioning_key
ANSIBLE_PRIVATE_KEY_FILE=/run/secrets/provisioning_key

# Where the ansible runner looks for playbooks/roles. Defaults to the
# baked-in /app/infra/ansible inside the image.
# ANSIBLE_ROOT=/app/infra/ansible

# Max ansible-playbook invocations running in parallel in one worker.
# Raise carefully — each ansible process eats ~200MB and ssh sessions.
MAX_CONCURRENT_ANSIBLE=3

# Escape hatch for dev: if "1", provisioning runs in-process inside the
# backend instead of being enqueued to RQ. Don't enable in prod.
ALLOW_INPROCESS_PROVISIONING=0

# Health-score threshold below which a node is considered unhealthy
# and auto-migration kicks in. Scored 0-100 by probes/.
MIN_HEALTHY_SCORE=50

# ────────────────────────────────────────────────────────────────
# Worker cron intervals (seconds)
# ────────────────────────────────────────────────────────────────
# Legacy invoice-per-period renewal tick — creates auto-renew invoices
# 3 days before expiry. Harmless to leave on while balance-billing
# takes over.
RENEWAL_CHECK_INTERVAL=300
RENEWAL_GRACE_HOURS=24

# Balance-billing tick: once per interval the worker anchors the clock
# and burns daily_rate × devices from each active sub's balance.
# Also runs the trial-expiry phase (warnings + clawback).
BALANCE_CHARGE_INTERVAL=3600

# Warn bot-users in Telegram when balance runway drops below this.
LOW_BALANCE_WARN_DAYS=3

# Warm credential pool reconcile tick.
WARM_POOL_CHECK_INTERVAL=120

# Autoscale upscale/downscale tick. 0 disables autoscale entirely.
AUTOSCALE_INTERVAL=300

# Downscale drain tick — only relevant if AUTOSCALE_DOWNSCALE_ENABLED=1.
DRAIN_TICK_INTERVAL=600
DRAIN_MIGRATE_BATCH=10

# ────────────────────────────────────────────────────────────────
# Balance billing & trial
# ────────────────────────────────────────────────────────────────
# Hard cap per freeze event and yearly freeze budget per subscription.
MAX_FREEZE_DAYS_PER_PERIOD=14
FREEZE_YEAR_BUDGET_DAYS=30

# Minimum topup amount (kopecks). 10000 = ₽100.
MIN_TOPUP_KOPECKS=10000

# Extra device surcharge per month, in kopecks. 10000 = ₽100/month/device
# beyond plan.max_devices.
EXTRA_DEVICE_KOPECKS_PER_MONTH=10000

# Referral bonus (kopecks). Credited to the referee when they activate
# the trial, and to the referrer when the referee makes their first
# real kind=topup. See docs/TRIAL_SYSTEM.md.
REFERRAL_BONUS_KOPECKS=5000

# Free-trial window length and how far in advance the worker warns
# about expiry. See docs/TRIAL_SYSTEM.md for the full mechanic.
TRIAL_DURATION_DAYS=30
TRIAL_EXPIRY_WARN_DAYS=3

# ────────────────────────────────────────────────────────────────
# Autoscale (pool-based)
# ────────────────────────────────────────────────────────────────
# Upscale fires when utilization of a pool crosses HIGH; downscale
# (if enabled) fires when it crosses LOW. Hysteresis = HIGH − LOW.
AUTOSCALE_HIGH_WATERMARK=0.8
AUTOSCALE_LOW_WATERMARK=0.3

# Hard ceiling/floor per pool. Autoscale never grows beyond MAX or
# shrinks below MIN.
AUTOSCALE_MAX_NODES=10
AUTOSCALE_MIN_NODES=1

# Capacity assumed for a node when we have no probe data yet (used
# during first ~5 minutes after spawn, before the pool has a signal).
AUTOSCALE_FALLBACK_CAPACITY=50

# Cooldown between consecutive spawn attempts in one pool, seconds.
# Prevents flapping if bootstrap fails repeatedly.
AUTOSCALE_SPAWN_BACKOFF=600

# Downscale is off by default — flip to 1 once you've watched it in
# staging and trust the drain/destroy loop.
AUTOSCALE_DOWNSCALE_ENABLED=0

# Quiet window in hours before a drained (zero-sub) node is destroyed,
# giving late connections a chance to migrate.
AUTOSCALE_DRAIN_GRACE_HOURS=24

# ────────────────────────────────────────────────────────────────
# VLESS Reality protocol defaults
# ────────────────────────────────────────────────────────────────
# Used by node_spawner when creating a Reality config on an
# auto-spawned node. Per-node override still possible via admin UI.
REALITY_SNI=www.microsoft.com
REALITY_DEST=www.microsoft.com:443
REALITY_PORT=443

# ────────────────────────────────────────────────────────────────
# Payment providers
# ────────────────────────────────────────────────────────────────
# Default single-provider mode. Comma-separated PAYMENT_PROVIDERS
# overrides this and enables multi-provider checkout UX.
PAYMENT_PROVIDER=cryptobot
# PAYMENT_PROVIDERS=cryptobot,yookassa,telegram_stars

# CryptoBot
CRYPTOBOT_TOKEN=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Comma-separated allowlist of YooKassa webhook source IPs. Leave empty
# to disable the IP check (only signature-based verification).
YOOKASSA_ALLOWED_IPS=

# Telegram Stars (in-bot native payments via XTR currency).
TELEGRAM_STARS_WEBHOOK_SECRET=

# Generic SBP providers — configured per slug via SBP_<slug>_* env set.
# See backend/app/services/payments/generic_sbp.py for the full list
# (HMAC_SECRET, PAY_URL_TEMPLATE, CREATE_URL, AUTH_HEADER,
#  PAID_STATUSES, DISPLAY_NAME, SIGNATURE_HEADER). Slug is whatever
# you put in PAYMENT_PROVIDERS, e.g. "sbp:sber" → SBP_SBER_*.

# ────────────────────────────────────────────────────────────────
# Telegram WebApp (Mini App)
# ────────────────────────────────────────────────────────────────
# Public HTTPS URL of the WebApp. The bot uses it to build the inline
# "🔐 Личный кабинет" button. Must be https:// or the button is hidden.
WEBAPP_BASE_URL=https://grinwer.online/app

# HMAC secret for signing WebApp session JWTs. Rotate and all open
# WebApp sessions are forced back through the initData handshake.
WEBAPP_JWT_SECRET=change-me-generate-with-python3-c-import-secrets-print-secrets-token_urlsafe-32

# JWT lifetime, seconds. 1800 = 30 minutes.
WEBAPP_JWT_TTL_SECONDS=1800

# Conversion ratio for the Stars checkout UX: how many Stars per ₽.
# Not a real exchange rate — just how plan prices render in the
# Stars card. Check real @PremiumBot pricing before editing.
WEBAPP_STARS_PER_RUB=0.67

# ────────────────────────────────────────────────────────────────
# Dynamic subscription links
# ────────────────────────────────────────────────────────────────
# Base URL for stable sub links (Hiddify/Streisand/v2rayNG-compatible).
# Empty → sub links disabled, clients get raw URIs.
SUB_LINK_BASE_URL=https://vpn.example.com/sub

# ────────────────────────────────────────────────────────────────
# Stage 2.5 — Warm credential pool
# ────────────────────────────────────────────────────────────────
# WARM_POOL_ENABLED=0 disables the pool and forces cold ansible on
# every purchase. Leave on unless debugging.
WARM_POOL_ENABLED=1

# Desired depth of warm bundles per active node. Higher = faster
# activations, but more wasted bundles when nodes roll.
WARM_POOL_TARGET=10

# Per-tick caps — how many bundles the warmer creates per node per
# tick, and how many parallel ansible runs the warmer can fire.
WARM_POOL_BATCH_PER_TICK=3
WARM_POOL_MAX_CONCURRENT=2
