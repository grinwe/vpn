# Database
DATABASE_URL=postgresql://vpn:change-me@db:5432/vpn
POSTGRES_PASSWORD=change-me

# Security
ADMIN_API_TOKEN=change-me-to-a-random-string
APP_SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token_urlsafe-32

# Telegram Bot
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_IDS=123456789

# Payments (pick one as default)
PAYMENT_PROVIDER=cryptobot
CRYPTOBOT_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_STARS_WEBHOOK_SECRET=

# Dynamic subscription links
SUB_LINK_BASE_URL=https://vpn.example.com/sub

# Worker
PROVISIONING_SSH_KEY=~/.ssh/vpn_provisioning_ed25519
AUTOSCALE_INTERVAL=300
# Renewal cron tick: every 5 min so the gap between expires_at and a hard
# revoke is bounded. Grace = how long an expired sub keeps its node access
# (gives users a window to top up before getting disconnected).
RENEWAL_CHECK_INTERVAL=300
RENEWAL_GRACE_HOURS=24

# Bot
NOTIFICATION_POLL_INTERVAL=10
